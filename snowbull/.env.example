# All optional. Without any of them SnowBull still works: it answers from its knowledge base with the local RAG engine
# and uses Yahoo Finance public endpoints for live quotes and headlines.

# Enables the LLM wording step (answers stay grounded in retrieved sources and are numerically guarded).
# Set ONE of the two; OpenAI is used if both are present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
SNOWBULL_MODEL=claude-sonnet-5-5

# Better live quotes and company news
FINNHUB_KEY=

# Comma-separated origins allowed to call the API from a browser, e.g. https://your-snowball-site.com
SNOWBULL_ALLOW_ORIGIN=*
